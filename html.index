      accent2: '#00E676'
    },
    {
      id: 'a2',
      name: 'BGAUSS A2',
      image: 'https://images.unsplash.com/photo-1609630875171-b1321377ee65?w=900&q=80&auto=format&fit=crop',
      price: 124999,
      discount: 12000,
      range: 'Up to 150 km',
      battery: '5.2 kWh',
      speed: '70 km/h',
      charging: 'Approx. 5 hours',
      warranty: 'Warranty details on enquiry',
      colors: ['Carbon Black', 'Lunar Silver', 'Cyan Accent'],
      tagline: 'A modern premium electric scooter designed for confident everyday commuting.',
      features: ['Premium design','Digital instrument cluster','Smart connectivity','Multiple riding modes','Fast charging support','Advanced safety features'],
      accent1: '#00E676',
      accent2: '#00BFA6'
    },
    {
      id: 'aero',
      name: 'BGAUSS AERO',
      image: 'https://images.unsplash.com/photo-1614026480209-a4a1f0a3db4a?w=900&q=80&auto=format&fit=crop',
      price: 134999,
      discount: 15000,
      range: 'Up to 160 km',
      battery: '5.5 kWh',
      speed: '75 km/h',
      charging: 'Approx. 5–6 hours',
      warranty: 'Warranty details on enquiry',
      colors: ['Stealth Black', 'Aurora White', 'Aero Blue'],
      tagline: 'A futuristic electric scooter concept focused on range, technology and premium urban mobility.',
      features: ['Premium LED lighting','Digital dashboard','Smart connectivity','Multiple riding modes','Advanced braking','Premium suspension'],
      accent1: '#00D9FF',
      accent2: '#00E676'
    }
  ];

  const HERO_IMAGE = 'https://images.unsplash.com/photo-1571068316344-75bc76f77890?w=1400&q=85&auto=format&fit=crop';

  /* ----------------------------------------------------------
     3. HELPERS
     ---------------------------------------------------------- */
  const $  = (s, c) => (c || document).querySelector(s);
  const $$ = (s, c) => Array.from((c || document).querySelectorAll(s));

  const inr = n => '₹' + n.toLocaleString('en-IN');
  const off = n => '₹' + n.toLocaleString('en-IN') + ' OFF';
  const getProduct = id => PRODUCTS.find(p => p.id === id);

  function waLink(message) {
    return 'https://wa.me/' + SHOWROOM.whatsapp + '?text=' + encodeURIComponent(message);
  }

  function generateWhatsAppLink(product) {
    const msg =
      'Hello ' + SHOWROOM.name + ',\n\n' +
      'I am interested in the ' + product.name + ' electric scooter.\n\n' +
      'Please share the latest on-road price, available discount, finance options, ' +
      'colours and availability.\n\n' +
      'Thank you.';
    return waLink(msg);
  }

  const GENERAL_WA = waLink(
    'Hello ' + SHOWROOM.name + ',\n\n' +
    'I would like to know more about BGAUSS electric scooters.\n\n' +
    'Please share the available models, prices and offers.'
  );

  function enquiryWa(name, model, mobile, message) {
    return waLink(
      'Hello ' + SHOWROOM.name + ',\n\n' +
      'My name is ' + name + '.\n\n' +
      'I am interested in ' + model + '.\n\n' +
      'My mobile number is ' + mobile + '.\n\n' +
      'My enquiry:\n' + message + '\n\n' +
      'Please share the latest details.'
    );
  }

  /* ----------------------------------------------------------
     4. SVG FALLBACK ILLUSTRATION
     ---------------------------------------------------------- */
  function scooterArt(a1, a2, uid) {
    return `
<svg viewBox="0 0 440 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Electric scooter illustration">
  <defs>
    <linearGradient id="bd-${uid}" x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#232d35"/><stop offset="0.55" stop-color="#141b21"/><stop offset="1" stop-color="#080d11"/>
    </linearGradient>
    <linearGradient id="ac-${uid}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="${a1}"/><stop offset="1" stop-color="${a2}"/>
    </linearGradient>
    <linearGradient id="seat-${uid}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2b363e"/><stop offset="1" stop-color="#131a1f"/>
    </linearGradient>
    <radialGradient id="gl-${uid}" cx="50%" cy="50%">
      <stop offset="0" stop-color="${a1}" stop-opacity="0.5"/><stop offset="1" stop-color="${a1}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="hl-${uid}" cx="50%" cy="50%">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95"/><stop offset="0.45" stop-color="${a2}" stop-opacity="0.85"/><stop offset="1" stop-color="${a2}" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <ellipse cx="220" cy="252" rx="170" ry="18" fill="url(#gl-${uid})"/>
  <circle cx="112" cy="196" r="47" fill="#0b1014"/>
  <circle cx="112" cy="196" r="47" fill="none" stroke="#232c33" stroke-width="3"/>
  <circle cx="112" cy="196" r="31" fill="none" stroke="#2c363e" stroke-width="3"/>
  <circle cx="112" cy="196" r="10" fill="url(#ac-${uid})" opacity="0.9"/>
  <circle cx="338" cy="196" r="47" fill="#0b1014"/>
  <circle cx="338" cy="196" r="47" fill="none" stroke="#232c33" stroke-width="3"/>
  <circle cx="338" cy="196" r="31" fill="none" stroke="#2c363e" stroke-width="3"/>
  <circle cx="338" cy="196" r="10" fill="url(#ac-${uid})" opacity="0.9"/>
  <path d="M58 198 C46 156 54 114 88 102 L156 94 C180 92 196 105 197 128 L198 196 C198 206 188 211 170 211 L86 211 C68 211 60 207 58 198 Z" fill="url(#bd-${uid})" stroke="#2b353d" stroke-width="1.5"/>
  <path d="M74 168 C86 150 108 142 136 141 L186 140" fill="none" stroke="url(#ac-${uid})" stroke-width="4" stroke-linecap="round" opacity="0.9"/>
  <path d="M70 102 C70 84 84 74 106 72 L172 68 C188 67 198 75 198 90 L198 101 C160 107 108 107 70 102 Z" fill="url(#seat-${uid})" stroke="#333e46" stroke-width="1.2"/>
  <path d="M192 168 L272 168 L282 192 C284 200 278 206 268 206 L200 206 C193 206 190 200 190 192 Z" fill="url(#bd-${uid})" stroke="#2b353d" stroke-width="1.4"/>
  <path d="M254 172 C254 136 260 106 278 90 C292 77 312 74 326 82 L337 89 C348 97 347 116 341 134 L322 172 Z" fill="url(#bd-${uid})" stroke="#2b353d" stroke-width="1.5"/>
  <circle cx="330" cy="104" r="20" fill="url(#hl-${uid})" opacity="0.55"/>
  <circle cx="330" cy="104" r="13" fill="#eaf6ff" opacity="0.92"/>
  <circle cx="330" cy="104" r="13" fill="none" stroke="#2b353d" stroke-width="1.5"/>
  <path d="M305 84 L296 44 L310 40 L318 82 Z" fill="#1c2429" stroke="#333e46" stroke-width="1.2"/>
  <path d="M266 46 Q298 28 332 44" stroke="#1c2429" stroke-width="10" stroke-linecap="round" fill="none"/>
  <path d="M266 46 Q298 28 332 44" stroke="url(#ac-${uid})" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.85"/>
  <circle cx="266" cy="46" r="6.5" fill="#2a333a"/>
  <circle cx="332" cy="44" r="6.5" fill="#2a333a"/>
</svg>`;
  }

  /* ----------------------------------------------------------
     5. MEDIA HELPER — real image with SVG fallback
     ---------------------------------------------------------- */
  function scooterMedia(product, uid, opts) {
    opts = opts || {};
    const alt   = opts.alt || 'BGAUSS electric scooter';
    const cls   = opts.cls || '';
    const eager = !!opts.eager;

    if (!product.image) return scooterArt(product.accent1, product.accent2, uid);

    const fallback = scooterArt(product.accent1, product.accent2, uid)
      .replace(/"/g, '&quot;')
      .replace(/\n/g, '');

    return '<img src="' + product.image + '" alt="' + alt + '" class="' + cls + '" '
      + (eager ? '' : 'loading="lazy" ')
      + 'decoding="async" '
      + 'onerror="this.onerror=null;this.outerHTML=this.dataset.fallback;" '
      + 'data-fallback="' + fallback + '">';
  }

  /* ----------------------------------------------------------
     6. RENDER: HERO SCOOTER
     ---------------------------------------------------------- */
  $('#heroScooter').innerHTML = scooterMedia(
    { image: HERO_IMAGE, accent1: '#00E676', accent2: '#00D9FF' },
    'hero',
    { eager: true, cls: 'hero-scooter-img', alt: 'BGAUSS electric scooter at Priyanshi Motors, Bhadrak' }
  );

  /* ----------------------------------------------------------
     7. RENDER: SCOOTER GRID
     ---------------------------------------------------------- */
  const compareList = [];

  function specIcon(type) {
    const icons = {
      range: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>',
      battery: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="17" height="10" rx="2.5"/><path d="M22 11v2"/></svg>',
      speed: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 1 9-9"/><path d="m12 12 5-3"/></svg>'
    };
    return icons[type] || '';
  }

  function renderGrid() {
    const grid = $('#scooterGrid');
    grid.innerHTML = PRODUCTS.map((p, i) => `
      <article class="scooter-card rv ${i % 3 === 1 ? 'rv-d1' : i % 3 === 2 ? 'rv-d2' : ''}"
               style="--acc1:${p.accent1};--acc2:${p.accent2}"
               data-id="${p.id}">
        <div class="card-media">
          <span class="media-glow" aria-hidden="true"></span>
          <span class="card-badge">BGAUSS Electric</span>
          <span class="card-off">${off(p.discount)}</span>
          ${scooterMedia(p, 'card-' + p.id, {
            alt: p.name + ' electric scooter at Priyanshi Motors, Bhadrak',
            cls: 'card-img'
          })}
        </div>

        <div class="card-body">
          <h3 class="card-model">${p.name}</h3>
          <p class="card-desc">${p.tagline}</p>

          <div class="card-price-row">
            <span class="card-price">${inr(p.price)}</span>
            <span class="card-price-note">Demo price · confirm with showroom</span>
          </div>

          <div class="spec-row">
            <div class="spec">
              <span class="s-ico">${specIcon('range')}</span>
              <span class="s-val">${p.range.replace('Up to ', '')}</span>
              <span class="s-key">Range</span>
            </div>
            <div class="spec">
              <span class="s-ico">${specIcon('battery')}</span>
              <span class="s-val">${p.battery}</span>
              <span class="s-key">Battery</span>
            </div>
            <div class="spec">
              <span class="s-ico">${specIcon('speed')}</span>
              <span class="s-val">${p.speed}</span>
              <span class="s-key">Top Speed</span>
            </div>
          </div>

          <div class="card-actions">
            <a class="btn btn-ghost btn-sm" href="#/scooters/${p.id}">View Details</a>
            <a class="btn btn-wa btn-sm" href="${generateWhatsAppLink(p)}" target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>

        <button class="compare-toggle" data-compare="${p.id}" type="button" aria-pressed="false">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          <span>Compare</span>
        </button>
      </article>
    `).join('');
  }
  renderGrid();

  /* ----------------------------------------------------------
     8. RENDER: COMPARE
     ---------------------------------------------------------- */
  function renderCompare() {
    const root = $('#compareRoot');

    if (compareList.length === 0) {
      root.innerHTML = `
        <div class="compare-wrap">
          <div class="compare-empty">
            <div class="ce-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </div>
            <p style="font-weight:600;color:var(--white);font-size:1rem">No scooters selected yet</p>
            <p style="margin-top:.4rem;font-size:.875rem">Pick up to three models below to compare them side by side.</p>
            <div class="compare-chips">
              ${PRODUCTS.map(p => `<button class="chip" data-compare="${p.id}" type="button">${p.name.replace('BGAUSS ', '')}</button>`).join('')}
            </div>
          </div>
        </div>`;
      return;
    }

    const rows = [
      ['Price',        p => inr(p.price)],
      ['Discount',     p => off(p.discount)],
      ['Range',        p => p.range],
      ['Battery',      p => p.battery],
      ['Top Speed',    p => p.speed],
      ['Charging',     p => p.charging],
      ['Key Features', p => p.features.slice(0, 4).join(', ')]
    ];

    root.innerHTML = `
      <div class="compare-wrap">
        <div class="compare-scroll">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col" style="background:transparent"></th>
                ${compareList.map(id => {
                  const p = getProduct(id);
                  return `<th scope="col">
                    <div class="col-head">
                      <span>${p.name}</span>
                      <button class="rm" data-remove="${p.id}" type="button">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                        Remove
                      </button>
                    </div>
                  </th>`;
                }).join('')}
              </tr>
            </thead>
            <tbody>
              ${rows.map(([label, fn]) => `
                <tr>
                  <th scope="row">${label}</th>
                  ${compareList.map(id => `<td>${fn(getProduct(id))}</td>`).join('')}
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>

      ${compareList.length < 3 ? `
        <div class="compare-chips" style="margin-top:1.5rem">
          ${PRODUCTS.filter(p => !compareList.includes(p.id))
            .map(p => `<button class="chip" data-compare="${p.id}" type="button">+ Add ${p.name.replace('BGAUSS ', '')}</button>`).join('')}
        </div>` : `
        <p style="text-align:center;margin-top:1.25rem;font-size:.8rem;color:var(--muted)">
          You can compare up to 3 scooters. Remove one to add another.
        </p>`}
    `;
  }
  renderCompare();

  document.addEventListener('click', function (e) {
    const addBtn = e.target.closest('[data-compare]');
    if (addBtn) {
      const id = addBtn.dataset.compare;
      if (compareList.includes(id)) return;
      if (compareList.length >= 3) { showToast('You can compare up to 3 scooters'); return; }
      compareList.push(id);
      syncCompareButtons();
      renderCompare();
      showToast(getProduct(id).name + ' added to compare');
      return;
    }

    const rmBtn = e.target.closest('[data-remove]');
    if (rmBtn) {
      const id = rmBtn.dataset.remove;
      const i = compareList.indexOf(id);
      if (i > -1) compareList.splice(i, 1);
      syncCompareButtons();
      renderCompare();
    }
  });

  function syncCompareButtons() {
    $$('.compare-toggle').forEach(btn => {
      const active = compareList.includes(btn.dataset.compare);
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
      btn.querySelector('span').textContent = active ? 'Added' : 'Compare';
    });
  }

  /* ----------------------------------------------------------
     9. ROUTER (hash-based → GitHub Pages safe)
     ---------------------------------------------------------- */
  const pageHome = $('#page-home');
  const pageProduct = $('#page-product');

  function showHome() {
    pageHome.classList.remove('hidden');
    pageProduct.classList.remove('active');
    pageProduct.innerHTML = '';
    document.title = 'Priyanshi Motors | BGAUSS Electric Scooters in Bhadrak';
  }

  function showProduct(p) {
    pageHome.classList.add('hidden');
    pageProduct.classList.add('active');
    document.title = p.name + ' | Priyanshi Motors Bhadrak';

    pageProduct.innerHTML = `
      <section class="pd-hero" style="--acc1:${p.accent1};--acc2:${p.accent2}">
        <div class="container">
          <a class="pd-back" href="#/">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
            Back to all scooters
          </a>

          <div class="pd-grid">
            <div class="pd-media">
              ${scooterMedia(p, 'pd-' + p.id, {
                eager: true,
                alt: p.name + ' — BGAUSS electric scooter at Priyanshi Motors, Charampa, Bhadrak',
                cls: 'pd-img'
              })}
            </div>

            <div>
              <span class="pd-tag">BGAUSS Electric Scooter</span>
              <h1 class="pd-title" style="margin-top:.7rem">${p.name}</h1>
              <p class="pd-desc">${p.tagline}</p>

              <div class="pd-price-row">
                <span class="pd-price">${inr(p.price)}</span>
                <span class="pd-off">${off(p.discount)}</span>
                <span class="pd-price-note">Demo pricing — please confirm current on-road price with the showroom.</span>
              </div>

              <div class="pd-specs">
                <div class="pd-spec"><div class="v">${p.range.replace('Up to ', '')}</div><div class="k">Range</div></div>
                <div class="pd-spec"><div class="v">${p.battery}</div><div class="k">Battery</div></div>
                <div class="pd-spec"><div class="v">${p.speed}</div><div class="k">Top Speed</div></div>
                <div class="pd-spec"><div class="v">${p.charging.replace('Approx. ', '')}</div><div class="k">Charging</div></div>
              </div>

              <div class="pd-block">
                <h3>Key Features</h3>
                <ul class="feature-list">
                  ${p.features.map(f => `
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                      ${f}
                    </li>`).join('')}
                </ul>
              </div>

              <div class="pd-cta">
                <a class="btn btn-wa" href="${generateWhatsAppLink(p)}" target="_blank" rel="noopener">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.09 3.2 5.07 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.55 2 2.1 6.45 2.1 11.94c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.48 0 9.94-4.45 9.94-9.94 0-2.65-1.03-5.15-2.9-7.02A9.86 9.86 0 0 0 12.04 2z"/></svg>
                  Enquire on WhatsApp
                </a>
                <a class="btn btn-ghost" href="tel:${SHOWROOM.phoneTel}">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  Call Now
                </a>
              </div>

              <div class="pd-meta">
                <div>Available Colours<strong>${p.colors.join(' · ')}</strong></div>
                <div>Warranty<strong>${p.warranty}</strong></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    `;
  }

  function router() {
    const hash = location.hash || '#/';
    const m = hash.match(/^#\/scooters\/([\w-]+)$/);

    if (m) {
      const p = getProduct(m[1]);
      if (p) {
        showProduct(p);
        window.scrollTo({ top: 0, behavior: 'auto' });
        return;
      }
    }
    showHome();
  }

  window.addEventListener('hashchange', router);
  router();

  /* ----------------------------------------------------------
     10. SMOOTH IN-PAGE ANCHOR NAVIGATION
     ---------------------------------------------------------- */
  document.addEventListener('click', function (e) {
    const link = e.target.closest('a[href^="#"]');
    if (!link) return;
    const href = link.getAttribute('href');
    if (!href || href === '#' || href.startsWith('#/')) return;

    e.preventDefault();
    const id = href.slice(1);

    if (pageProduct.classList.contains('active')) {
      location.hash = '#/';
      setTimeout(() => scrollToId(id), 60);
    } else {
      scrollToId(id);
    }
    closeSidebar();
  });

  function scrollToId(id) {
    const el = document.getElementById(id);
    if (!el) return;
    const y = el.getBoundingClientRect().top + window.pageYOffset - 84;
    window.scrollTo({ top: y, behavior: 'smooth' });
  }

  /* ----------------------------------------------------------
     11. NAVBAR SCROLL STATE + MOBILE BAR
     ---------------------------------------------------------- */
  const navbar = $('#navbar');
  const mobileBar = $('#mobileBar');
  let ticking = false;

  function onScroll() {
    const y = window.pageYOffset;
    navbar.classList.toggle('scrolled', y > 24);
    mobileBar.classList.toggle('show', y > 320);
    ticking = false;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
  }, { passive: true });
  onScroll();

  /* ----------------------------------------------------------
     12. MOBILE SIDEBAR
     ---------------------------------------------------------- */
  const sidebar = $('#sidebar');
  const overlay = $('#overlay');
  const burger = $('#burger');

  function openSidebar() {
    sidebar.classList.add('open');
    overlay.classList.add('open');
    sidebar.setAttribute('aria-hidden', 'false');
    burger.setAttribute('aria-expanded', 'true');
    document.body.classList.add('no-scroll');
  }
  function closeSidebar() {
    sidebar.classList.remove('open');
    overlay.classList.remove('open');
    sidebar.setAttribute('aria-hidden', 'true');
    burger.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('no-scroll');
  }

  burger.addEventListener('click', openSidebar);
  $('#sidebarClose').addEventListener('click', closeSidebar);
  overlay.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar(); });

  /* ----------------------------------------------------------
     13. WHATSAPP GENERAL LINKS
     ---------------------------------------------------------- */
  $$('[data-wa-general]').forEach(el => {
    el.setAttribute('href', GENERAL_WA);
    el.setAttribute('target', '_blank');
    el.setAttribute('rel', 'noopener');
  });

  /* ----------------------------------------------------------
     14. ENQUIRY FORM
     ---------------------------------------------------------- */
  const form = $('#enquiryForm');
  const modelSelect = $('#f-model');

  modelSelect.innerHTML =
    '<option value="" disabled selected>Choose a scooter model</option>' +
    PRODUCTS.map(p => `<option value="${p.name}">${p.name} — ${inr(p.price)}</option>`).join('') +
    '<option value="Not sure yet">Not sure yet — please guide me</option>';

  function setInvalid(field, invalid) {
    field.classList.toggle('invalid', invalid);
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    const nameField   = $('#f-name').closest('.field');
    const mobileField = $('#f-mobile').closest('.field');
    const modelField  = $('#f-model').closest('.field');
    const msgField    = $('#f-message').closest('.field');

    const name   = $('#f-name').value.trim();
    const mobile = $('#f-mobile').value.trim();
    const model  = $('#f-model').value;
    const msg    = $('#f-message').value.trim();

    const nameOk   = name.length >= 2;
    const mobileOk = /^[6-9]\d{9}$/.test(mobile.replace(/\D/g, ''));
    const modelOk  = !!model;
    const msgOk    = msg.length >= 3;

    setInvalid(nameField, !nameOk);
    setInvalid(mobileField, !mobileOk);
    setInvalid(modelField, !modelOk);
    setInvalid(msgField, !msgOk);

    if (!(nameOk && mobileOk && modelOk && msgOk)) {
      const firstBad = $('.field.invalid input, .field.invalid select, .field.invalid textarea');
      if (firstBad) firstBad.focus();
      showToast('Please check the highlighted fields');
      return;
    }

    window.open(enquiryWa(name, model, mobile, msg), '_blank', 'noopener');
    showToast('Opening WhatsApp…');
    form.reset();
    $$('.field', form).forEach(f => f.classList.remove('invalid'));
  });

  form.addEventListener('input', function (e) {
    const field = e.target.closest('.field');
    if (field) field.classList.remove('invalid');
  });

  /* ----------------------------------------------------------
     15. SCROLL REVEAL
     ---------------------------------------------------------- */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function observeReveals() {
    const items = $$('.rv:not(.in)');
    if (reduceMotion || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('in'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });

    items.forEach(el => io.observe(el));
  }
  observeReveals();

  /* ----------------------------------------------------------
     16. TOAST
     ---------------------------------------------------------- */
  let toastTimer;
  function showToast(text) {
    const t = $('#toast');
    t.textContent = text;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2400);
  }

  /* ----------------------------------------------------------
     17. FOOTER YEAR
     ---------------------------------------------------------- */
  $('#year').textContent = new Date().getFullYear();

  /* ----------------------------------------------------------
     18. DEBUG EXPOSE
     ---------------------------------------------------------- */
  window.PRIYANSHI = { PRODUCTS, SHOWROOM, generateWhatsAppLink, waLink };
})();
</script>
</body>
</html>
